{
  "schemaVersion": 1,
  "id": "simplestoragemanager",
  "version": "v${version}",
  "name": "Simple Storage Manager",
  "description": "A Minecraft mod that lets you access your storage from anywhere, without having to walk back and forth to your chests.",
  "authors": [
    "InterPlay"
  ],
  "license": "MIT",
  "icon": "assets/simplestoragemanager/textures/mod_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.interplay.simplestoragemanager.SimpleStorageManager"
    ],
    "client": [
      "net.interplay.simplestoragemanager.client.SimpleStorageManagerClient"
    ],
    "rei_common": [
      "net.interplay.simplestoragemanager.integration.ReiUpgradeRecipePlugin"
    ],
    "rei_client": [
      "net.interplay.simplestoragemanager.integration.ReiTerminalIntegration"
    ]
  },
  "mixins": [
    "simplestoragemanager.mixins.json"
  ],
  "accessWidener": "simplestoragemanager.accesswidener",
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~1.21.8",
    "java": ">=21",
    "fabric-api": ">=0.136.1"
  },
  "suggests": {
    "roughlyenoughitems": "*",
    "storagedrawers": "*"
  }
}
